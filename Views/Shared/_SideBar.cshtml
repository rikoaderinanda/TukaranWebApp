<div class="d-flex flex-column flex-shrink-0 p-3 bg-light shadow" style="width: 250px; min-height: 100vh;" x-data="{ openMenu: null }">
    @* <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-decoration-none">
        <span class="fs-4 fw-bold">Tukaran</span>
    </a> *@
    @* <hr> *@
    <ul class="nav nav-pills flex-column mb-auto">

        <li class="nav-item">
            <a asp-controller="Home" asp-action="Index" class="nav-link active">
                <i class="bi bi-house-door me-2"></i> Dashboard
            </a>
        </li>

        <!-- Barang Dropdown -->
        <li class="nav-item">
            <a href="#" class="nav-link text-dark d-flex justify-content-between align-items-center"
               x-on:click.prevent="openMenu === 'barang' ? openMenu = null : openMenu = 'barang'">
                <span><i class="bi bi-box-seam me-2"></i> Barang</span>
                <i class="bi" :class="openMenu === 'barang' ? 'bi-chevron-up' : 'bi-chevron-down'"></i>
            </a>
            <ul class="list-unstyled ps-4" x-show="openMenu === 'barang'" x-transition>
                <li><a asp-controller="Item" asp-action="Index" class="nav-link text-dark">Daftar Barang</a></li>
                <li><a asp-controller="Item" asp-action="Create" class="nav-link text-dark">Tambah Barang</a></li>
            </ul>
        </li>

        <!-- Tukaran -->
        <li class="nav-item">
            <a asp-controller="Transaction" asp-action="Index" class="nav-link text-dark">
                <i class="bi bi-arrow-left-right me-2"></i> Tukaran
            </a>
        </li>

        <!-- Akun Dropdown -->
        <li class="nav-item">
            <a href="#" class="nav-link text-dark d-flex justify-content-between align-items-center"
               x-on:click.prevent="openMenu === 'akun' ? openMenu = null : openMenu = 'akun'">
                <span><i class="bi bi-person-circle me-2"></i> Akun</span>
                <i class="bi" :class="openMenu === 'akun' ? 'bi-chevron-up' : 'bi-chevron-down'"></i>
            </a>
            <ul class="list-unstyled ps-4" x-show="openMenu === 'akun'" x-transition>
                <li><a asp-controller="Account" asp-action="Profile" class="nav-link text-dark">Profil</a></li>
                <li><a asp-controller="Account" asp-action="Settings" class="nav-link text-dark">Pengaturan</a></li>
            </ul>
        </li>

        <li>
            <a asp-controller="Account" asp-action="Logout" class="nav-link text-danger">
                <i class="bi bi-box-arrow-right me-2"></i> Logout
            </a>
        </li>

    </ul>
    <hr>
    <div class="text-muted small">
        &copy; 2025 TukaranApp
    </div>
</div>
