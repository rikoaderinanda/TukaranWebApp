<!DOCTYPE html>
<html lang="en" x-data="layout()" x-init="init()" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TukaranApp</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>

    <style>
        body {
            overflow-x: hidden;
        }
        .sidebar {
            width: 250px;
            transition: transform 0.3s ease-in-out;
        }
        .sidebar-hidden {
            transform: translateX(-100%);
        }
        .sidebar-visible {
            transform: translateX(0);
        }
        @@media (min-width: 768px) {
            .sidebar {
                transform: translateX(0) !important;
            }
        }
        .rotate-180 
        {
            transform: rotate(180deg);
            transition: transform 0.2s ease-in-out;
        }
    </style>

</head>
<body class="h-100 d-flex flex-column">
    @if(User.Identity.IsAuthenticated)
    {  
        <!-- Topbar -->
        <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm px-3">
            <button class="btn btn-outline-secondary" x-on:click="toggleSidebar">
                <i class="bi bi-list"></i>
            </button>
            <a class="navbar-brand ms-3 fw-bold" href="#">TukaranApp</a>
            <div class="ms-auto d-flex align-items-center">
                <span class="me-3">Hi, @User.Identity?.Name</span>
                <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </a>
            </div>
        </nav>
    }

    <div class="d-flex flex-grow-1">
        @if(User.Identity.IsAuthenticated)
        {    
            <div class="bg-light sidebar shadow position-fixed h-100 z-3"
                :style="{ width: sidebarWidth, transform: isMobile && !sidebarOpen ? 'translateX(-100%)' : 'translateX(0)' }"
                x-on:click.outside="isMobile && (sidebarOpen = false)">
                @await Html.PartialAsync("_Sidebar")
            </div>
        }

        <!-- Main Content -->
        <main class="flex-grow-1 p-4"
            :style="{ marginLeft: !isMobile ? sidebarWidth : '0' }">
            @RenderBody()
        </main>
    </div>
<script>
    function layout() {
        return {
            sidebarOpen: true,
            isMobile: window.innerWidth < 768,
            collapsed: false,

            init() {
                this.updateDevice()
                window.addEventListener('resize', () => this.updateDevice())
            },

            updateDevice() {
                this.isMobile = window.innerWidth < 768
                if (this.isMobile) {
                    this.sidebarOpen = false
                } else {
                    this.sidebarOpen = true
                }
            },

            toggleSidebar() {
                if (this.isMobile) {
                    this.sidebarOpen = !this.sidebarOpen
                } else {
                    this.collapsed = !this.collapsed
                }
            },

            get sidebarWidth() {
                if (this.isMobile) return this.sidebarOpen ? '250px' : '0'
                return this.collapsed ? '60px' : '250px'
            }
        }
    }
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
